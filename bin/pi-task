#!/usr/bin/env bash
# Tracked Pi tasks: run/reply/status/list/log/cancel/pending/ack; data in ~/.pi/tasks/.
here="$(cd "$(dirname "$0")" && pwd)"
export PATH=$HOME/.pi/agent/bin:$HOME/.local/bin:$PATH
# Optional model-path preflight (e.g. bin/pi-preflight.example): runs before run/reply/approve,
# and again (in parallel) when Pi auto-retries a connection error such as UND_ERR_SOCKET.
if [ -z "${PI_TASK_PREFLIGHT:-}" ] && [ -x "$here/pi-preflight" ]; then PI_TASK_PREFLIGHT="$here/pi-preflight"; fi
if [ -n "${PI_TASK_PREFLIGHT:-}" ]; then
  export PI_TASK_PREFLIGHT
  case "${1:-}" in run|reply|approve) [ -x "$PI_TASK_PREFLIGHT" ] && "$PI_TASK_PREFLIGHT" || true ;; esac
fi
exec "$here/pi-task.mjs" "$@"
